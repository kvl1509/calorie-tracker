# ==========================================
# BiteWise Backend Environment Configuration
# ==========================================

# Environment Mode: development / production
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/calorie_tracker
# PostgreSQL for production: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calorie_tracker

# AI Provider Configuration
# Supported providers: "gemini", "openai", "fallback"
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/)
AI_API_KEY=
# Model name (e.g., "gemini-2.0-flash", "gemini-1.5-flash", "gemini-1.5-pro")
AI_MODEL=gemini-2.0-flash

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Email Configuration
# Add your resend API key here. If empty, local mailhog SMTP is used.
RESEND_API_KEY=

